{
  "agent": "claude",
  "model": "MODEL_ID",
  "cwd": "/absolute/path/to/workspace",
  "sessionKey": "unique-task-id",
  "promptFile": "/absolute/private/path/prompt.txt",
  "responseFile": "/absolute/private/path/response.txt",
  "stateDir": "/absolute/private/path/acpx-state",
  "runtimeModule": "/absolute/path/to/plugin-local/acpx",
  "timeoutMs": 7200000,
  "progressMs": 600000,
  "maxResponseBytes": 1048576,
  "allowKinds": [
    "read",
    "search",
    "think",
    "edit",
    "execute"
  ]
}
